# Global configuration
# Include patterns - if specified, only files matching these patterns will be linted
# Use glob patterns like *.go, **/*.go, src/**/*.go, etc.
include = ["**/*.go", "**/*.js", "**/*.ts"]

# Exclude patterns - files matching these patterns will be excluded from linting
# These are applied after include patterns
exclude = ["vendor/**", "node_modules/**", "**/*_test.go", "**/testdata/**"]

[rules.no-trailing-comma]
language="go"
message = "do not use trailing comma for args"
query='(argument_list "," @region .)'
# Per-rule patterns: only check main source files, not config files
include = ["**/*.go"]
exclude = ["**/config*.go"]

[rules.no-string-comparison]
language="go"
message = "do not use \"\" to check for empty string for '{}'"
query='''((binary_expression
  (identifier) @region ["==" "!="] (interpreted_string_literal) @_ri)
  (#eq? @_ri "\"\""))'''
# This rule applies to all files (inherits global patterns)

[rules.standard-name-for-test-suite]
language="go"
message = "use 'suite' as the receiver name for {}"
query='''
((method_declaration
  (parameter_list
   (parameter_declaration (identifier) @name
                          (pointer_type) @type))
  (field_identifier) @region)
 (#not-eq? @name "suite")
 (#match? @type "Suite$")
 (#match? @region "^Test"))
'''
# Per-rule patterns: only check test files
include = ["**/*_test.go"]